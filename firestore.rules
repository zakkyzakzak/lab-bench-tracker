rules_version = '2';

// Lab Bench Tracker security rules.
// Only verified Wits Google accounts get in. The lab owner (config/lab) lists members,
// admins and supervisors. Supervisors see every project; everyone else sees only the
// projects they are a member of. Admins manage membership but do not see other projects.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function wits() {
      return signedIn() && email().matches('.*@(students[.])?wits[.]ac[.]za');
    }
    function labDoc() {
      return /databases/$(database)/documents/config/lab;
    }
    function lab() {
      return get(labDoc()).data;
    }
    function isAdmin() {
      return wits() && exists(labDoc()) && email() in lab().admins;
    }
    function isSup() {
      return wits() && exists(labDoc()) && email() in lab().supervisors;
    }
    function isMember() {
      return wits() && exists(labDoc()) &&
        (email() in lab().members || email() in lab().admins || email() in lab().supervisors);
    }
    function inProject(pid) {
      return email() in get(/databases/$(database)/documents/projects/$(pid)).data.members;
    }

    // Lab settings: who is in the lab, who supervises, who administers.
    match /config/lab {
      allow read: if wits();
      // One-time setup, only by the lab owner, who must list himself as admin and member.
      allow create: if wits() && email() == '2304452@students.wits.ac.za'
        && email() in request.resource.data.admins
        && email() in request.resource.data.members;
      allow update: if isAdmin() || isSup();
      allow delete: if false;
    }

    // Each person's own profile (name shown to others in the lab).
    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if wits() && request.auth.uid == uid
        && request.resource.data.email == email();
      allow delete: if false;

      // Private to that person: their own backlog of unfinished tasks.
      match /private/{docId} {
        allow read, write: if wits() && request.auth.uid == uid;
      }
    }

    // Projects and everything inside them (experiments, sample assignments, bench sessions,
    // weekly targets, result file links). Samples are listed on the project itself.
    match /projects/{pid} {
      allow read: if isSup() || (isMember() && email() in resource.data.members);
      // A supervisor sees every project anyway, so may create one without being listed.
      allow create: if isSup() || (isMember() && email() in request.resource.data.members);
      allow update: if isSup() || (isMember() && email() in resource.data.members);
      allow delete: if isSup();

      match /{coll}/{docId} {
        allow read, write: if isSup() || (isMember() && inProject(pid));
      }
    }

    // Lab-wide records shared by everyone in the lab.
    match /protocols/{id} {
      allow read, create, update: if isMember();
      allow delete: if isSup() || isAdmin() || (isMember() && resource.data.by == email());
    }
    match /reagents/{id} {
      allow read, create, update: if isMember();
      allow delete: if isSup() || isAdmin();
    }
    // Duties are added and dealt out by supervisors and admins. A member may only mark a
    // once-off duty as done.
    match /duties/{id} {
      allow read: if isMember();
      allow write: if isSup() || isAdmin();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneAt']);
    }
    // Who holds which duty in a month (document ID is the month, e.g. 2026-11).
    match /rota/{month} {
      allow read: if isMember();
      allow write: if isSup() || isAdmin();
    }
    // One entry each time someone ticks a duty as done.
    match /dutyLog/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == email();
      allow update, delete: if isSup() || isAdmin();
    }
    match /dutyRequests/{id} {
      allow read, create, update: if isMember();
      allow delete: if isSup() || isAdmin();
    }
    // Who has the site open right now: each person writes only their own entry.
    match /presence/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.email == email();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // A request for a sign-in link, made from the sign-in screen before the person is signed in.
    // Anyone may leave one for a Wits address; nobody can read them. The lab's mail sheet reads
    // them with the owner's own access and only ever sends a link to someone already in the lab.
    match /signinRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'site', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() < 100
        && request.resource.data.email.matches('[^@ ,;]+@(students[.])?wits[.]ac[.]za')
        && request.resource.data.site is string && request.resource.data.site.size() < 200;
      allow read, update, delete: if false;
    }
    // When each person had the site open. Each person writes only their own entries (the ID starts
    // with their own user ID); only admins can read them.
    match /visits/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isMember() && id.matches(request.auth.uid + '-[0-9]+')
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['email', 'day', 'from', 'to']);
    }
    match /notices/{id} {
      allow read: if isMember() && (resource.data.to == email() || isSup());
      allow create: if isMember() && request.resource.data.by == email();
      allow update, delete: if isMember() && resource.data.to == email();
    }
  }
}
